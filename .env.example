NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgresql://cliste:cliste@127.0.0.1:5432/cliste?schema=public
DIRECT_URL=postgresql://cliste:cliste@127.0.0.1:5432/cliste?schema=public
DATABASE_CONNECT_ON_BOOT=true
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
COOKIE_SECRET=replace-with-a-third-long-random-secret
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=cliste-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
